# Copia este archivo a .env y ajusta los valores según tu entorno.

# URL base del backend — la usa el cliente HTTP en src/services/api.ts
# Desarrollo: http://localhost:7777/api — Producción: https://api.mitumbes.com/api
PUBLIC_API_URL=http://localhost:7777/api

# Google Analytics 4 — se carga en Layout.astro si está definido (vacío = desactivado)
# Ejemplo: PUBLIC_GA4_ID=G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Vercel KV — almacenamiento para el tracking de bots de IA.
# Crear en: Vercel Dashboard → Storage → Create KV → Connect to project.
# Vercel inyecta estas variables automáticamente al conectar el KV al proyecto.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# API key para proteger el endpoint /api/ai-stats (ranking de modelos de IA).
# Genera una clave segura, p. ej.: openssl rand -hex 32
AI_STATS_API_KEY=

# Dominio canónico del sitio (producción: https://www.mitumbes.com)
# DOMAIN=https://www.mitumbes.com

# Clave para el endpoint POST /api/revalidate (la usa mitumbes-server).
# Debe coincidir con WEB_REVALIDATE_KEY del servidor.
CONTENT_REVALIDATE_KEY=

# Cloudflare — purga de caché desde POST /api/revalidate. Sin estas dos
# variables el endpoint solo confirma el ACK y el cambio se ve cuando expira
# el TTL de 10 minutos del borde.
# Zone ID: dashboard de Cloudflare → dominio mitumbes.com → Overview (columna derecha).
# API Token: My Profile → API Tokens → Create Token → permiso "Zone → Cache Purge".
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
