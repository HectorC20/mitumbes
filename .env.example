# Copia este archivo a .env y ajusta los valores según tu entorno.

# URL base del backend — la usa el cliente HTTP en src/services/api.ts
PUBLIC_API_URL=https://mitumbes.com

# Google Analytics 4 — se carga en Layout.astro si está definido (vacío = desactivado)
# Ejemplo: PUBLIC_GA4_ID=G-XXXXXXXXXX
PUBLIC_GA4_ID=
