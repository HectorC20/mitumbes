/** Mapeo de nombres semánticos → íconos Material Design (mdi) vía astro-icon. */
const ICONS: Record<string, string> = {
  search: 'mdi:magnify',
  pin: 'mdi:map-marker',
  clock: 'mdi:clock-outline',
  tag: 'mdi:tag-outline',
  star: 'mdi:star',
  'arrow-right': 'mdi:arrow-right',
  phone: 'mdi:phone',
  globe: 'mdi:earth',
  waves: 'mdi:waves',
  utensils: 'mdi:silverware-fork-knife',
  bed: 'mdi:bed',
  activity: 'mdi:pulse',
  calendar: 'mdi:calendar',
  info: 'mdi:information',
  compass: 'mdi:compass',
  menu: 'mdi:menu',
  car: 'mdi:car',
  check: 'mdi:check',
  copy: 'mdi:content-copy',
};

const customSvg = CUSTOM_SVGS[name];
const iconName = ICONS[name];

if (!customSvg && !iconName) {
  throw new Error(`Icono desconocido: ${name}`);
}
---

{
  customSvg ? (
    <svg
      class={`inline-block shrink-0 ${sizes[size]} ${className}`}
      viewBox="0 0 24 24"
      aria-hidden="true"
      set:html={customSvg}
    />
  ) : (
    <AstroIcon
      name={iconName}
      class={`inline-block shrink-0 ${sizes[size]} ${className}`}
      aria-hidden="true"
    />
  )
}
