if (!(name in paths)) {
  throw new Error(`Icono desconocido: ${name}`);
}
---

<svg
  class={`inline-block shrink-0 ${sizes[size]} ${Astro.props.class ?? ''}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
