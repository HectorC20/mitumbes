---
import { Icon as AstroIcon } from 'astro-icon/components';

interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { name, size = 'md', class: className = '' } = Astro.props;

const sizes = {
  sm: 'h-4 w-4',
  md: 'h-5 w-5',
  lg: 'h-6 w-6',
};

/** Mapeo de nombres semánticos → íconos Material Design (mdi) vía astro-icon. */
const ICONS: Record<string, string> = {
  search: 'mdi:magnify',
  pin: 'mdi:map-marker',
  clock: 'mdi:clock-outline',
  tag: 'mdi:tag-outline',
  star: 'mdi:star',
  'arrow-right': 'mdi:arrow-right',
  phone: 'mdi:phone',
  globe: 'mdi:earth',
  waves: 'mdi:waves',
  utensils: 'mdi:silverware-fork-knife',
  bed: 'mdi:bed',
  activity: 'mdi:pulse',
  calendar: 'mdi:calendar',
  info: 'mdi:information',
  compass: 'mdi:compass',
  menu: 'mdi:menu',
  car: 'mdi:car',
  check: 'mdi:check',
};

const iconName = ICONS[name];
if (!iconName) {
  throw new Error(`Icono desconocido: ${name}`);
}
---

<AstroIcon
  name={iconName}
  class={`inline-block shrink-0 ${sizes[size]} ${className}`}
  aria-hidden="true"
/>
