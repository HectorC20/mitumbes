---
import { SITE } from '../../shared/constants/site';
import { isLocale, localizePath, type Locale } from '../../shared/constants/locales';
import { t } from '../../shared/constants/ui';

interface Props {
  lang?: Locale;
}

const lang: Locale = isLocale(Astro.props.lang) ? Astro.props.lang : 'es';
const year = new Date().getFullYear();
const link = (path: string) => localizePath(path, lang);
---

<footer class="site-footer">
  <div class="container-page">
    <div class="site-footer__inner">
      <div>
        <a
          class="nav-shell__brand"
          href={link('/')}
          aria-label={`MiTumbes — ${t(lang, 'nav.home')}`}
        >
          <span class="nav-shell__logo">
            <img src="/isotipo.png" alt="ISOTIPO MI TUMBES" width="36" height="36" />
          </span>
          <span class="nav-shell__wordmark">
            <img src="/logo-text.png" alt="LOGO MI TUMBES" width="197" height="28" />
          </span>
        </a>
        <p class="site-footer__desc">
          {t(lang, 'seo.homeDescription')}
        </p>
      </div>
      <nav aria-label={t(lang, 'footer.placesHeading')}>
        <p class="site-footer__heading">{t(lang, 'footer.placesHeading')}</p>
        <a class="site-footer__link" href={link('/places/')}>
          {t(lang, 'footer.viewAllPlaces')}
        </a>
        <a class="site-footer__link" href={link('/categories/places/')}>
          {t(lang, 'footer.placesType1')}
        </a>
        <a class="site-footer__link" href={link('/categories/restaurants/')}>
          {t(lang, 'footer.placesType2')}
        </a>
        <a class="site-footer__link" href={link('/categories/hotels/')}>
          {t(lang, 'footer.placesType3')}
        </a>
      </nav>
      <nav aria-label={t(lang, 'footer.exploreHeading')}>
        <p class="site-footer__heading">{t(lang, 'footer.exploreHeading')}</p>
        <a class="site-footer__link" href={link('/categories/')}>
          {t(lang, 'footer.categories')}
        </a>
        <a class="site-footer__link" href={link('/zones/')}>
          {t(lang, 'footer.zones')}
        </a>
        <a class="site-footer__link" href={link('/partners/')}>
          {t(lang, 'footer.partners')}
        </a>
        <a class="site-footer__link" href={link('/zones/zorritos/')}>
          Zorritos
        </a>
        <a class="site-footer__link" href={link('/zones/punta-sal/')}>
          Punta Sal
        </a>
      </nav>
    </div>
    <div class="site-footer__legal-bar">
      <nav class="site-footer__legal-links" aria-label={t(lang, 'footer.legalHeading')}>
        <a class="site-footer__legal-link" href={link('/legal/')}>{t(lang, 'footer.legal')}</a>
        <span class="site-footer__legal-sep" aria-hidden="true">•</span>
        <a class="site-footer__legal-link" href={link('/privacy/')}>{t(lang, 'footer.privacy')}</a>
        <span class="site-footer__legal-sep" aria-hidden="true">•</span>
        <a class="site-footer__legal-link" href={link('/ethics/')}>{t(lang, 'footer.ethics')}</a>
      </nav>
      {t(lang, 'footer.verification') && <span>{t(lang, 'footer.verification')}</span>}
    </div>
    <div class="site-footer__note">
      <div class="site-footer__note-inner">
        <span>© {year} {SITE.name}. {t(lang, 'footer.note')}</span>
      </div>
    </div>
  </div>
</footer>
