---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  theme?: 'sand' | 'white';
}

const { eyebrow, title, lead, theme = 'sand' } = Astro.props;
---

<section class:list={['section', { 'section--sand': theme === 'sand' }]}>
  <div class="container-page">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="page-title">{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>
