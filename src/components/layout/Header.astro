---
import Icon from '../Icon.astro';
import {
  LOCALES,
  LOCALE_LABELS,
  LOCALE_SHORT,
  isLocale,
  localizePath,
  stripLocale,
  type Locale,
} from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';
import { SECTIONS, sectionLabel } from '@/shared/constants/sections';

interface Props {
  lang?: Locale;
}

const lang: Locale = isLocale(Astro.props.lang) ? Astro.props.lang : 'es';
const path = Astro.url.pathname;
const base = stripLocale(path);

const links = SECTIONS.map((section) => ({
  ...section,
  href: localizePath(section.path, lang),
  label: sectionLabel(section.id, lang),
}));

const isActive = (href: string) => {
  const current = path.replace(/\/$/, '');
  return current === href.replace(/\/$/, '');
};

const searchHref = localizePath('/lugares/', lang);
---

<header class="nav-shell">
  <div class="container-page nav-shell__inner">
    <a
      class="nav-shell__brand"
      href={localizePath('/', lang)}
      aria-label={`MiTumbes — ${t(lang, 'nav.home')}`}
    >
      <span class="nav-shell__logo"><Icon name="waves" size="sm" /></span>
      <span class="nav-shell__wordmark">MiTumbes</span>
    </a>

    <nav class="nav-shell__nav" aria-label={t(lang, 'nav.home')}>
      {
        links.map((link) => (
          <a
            class:list={[
              'nav-link',
              { 'nav-link--active': isActive(link.href) },
            ]}
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Búsqueda -->
    <form
      class="nav-search"
      role="search"
      action={searchHref}
      method="get"
    >
      <label class="sr-only" for="nav-search">{t(lang, 'nav.search')}</label>
      <input
        id="nav-search"
        class="nav-search__input"
        type="search"
        name="q"
        placeholder={t(lang, 'nav.searchPlaceholder')}
      />
      <button
        class="nav-search__submit"
        type="submit"
        aria-label={t(lang, 'nav.search')}
      >
        <Icon name="search" size="sm" />
      </button>
    </form>

    <!-- Selector de idioma -->
    <details class="nav-lang">
      <summary class="nav-lang__toggle" aria-label={t(lang, 'nav.language')}>
        <Icon name="globe" size="sm" />
        {LOCALE_SHORT[lang]}
      </summary>
      <div class="nav-lang__menu">
        {
          LOCALES.map((l) => (
            <a
              class:list={[
                'nav-lang__item',
                { 'nav-lang__item--active': l === lang },
              ]}
              href={localizePath(base, l)}
              lang={l}
              aria-current={l === lang ? 'true' : undefined}
            >
              {LOCALE_LABELS[l]}
            </a>
          ))
        }
      </div>
    </details>

    <!--
      EXPLORAR: deshabilitado por ahora — no cumple una buena función.
    <a class="btn btn--primary btn--sm" href={searchHref}>Explorar</a>
    -->

    <details class="nav-shell__mobile">
      <summary class="nav-shell__toggle" aria-label={t(lang, 'nav.menu')}>
        <Icon name="menu" />
      </summary>
      <nav class="nav-shell__mobile-list" aria-label={t(lang, 'nav.home')}>
        <form role="search" action={searchHref} method="get" class="nav-search--mobile">
          <input
            class="nav-search__input nav-search__input--mobile"
            type="search"
            name="q"
            placeholder={t(lang, 'nav.searchPlaceholder')}
          />
          <button
            class="nav-search__submit nav-search__submit--mobile"
            type="submit"
            aria-label={t(lang, 'nav.search')}
          >
            <Icon name="search" size="sm" />
          </button>
        </form>
        {
          links.map((link) => (
            <a
              class:list={[
                'nav-link',
                { 'nav-link--active': isActive(link.href) },
              ]}
              href={link.href}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
        <p class="mobile-lang__label">
          {t(lang, 'nav.language')}
        </p>
        <div class="mobile-lang">
          {
            LOCALES.map((l) => (
              <a
                class:list={[
                  'nav-link',
                  { 'nav-link--active': l === lang },
                ]}
                href={localizePath(base, l)}
                lang={l}
              >
                {LOCALE_LABELS[l]}
              </a>
            ))
          }
        </div>
      </nav>
    </details>
  </div>
</header>
