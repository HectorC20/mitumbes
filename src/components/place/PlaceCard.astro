---
import {
  imagenSrc,
  loc,
  rutaContenido,
  textoDeBusqueda,
  type Categoria,
  type ContenidoConRelaciones,
} from '../../shared/content/places';
import { COLLECTION_ICONS } from '../../shared/constants/collections';
import { isLocale, localizePath, type Locale } from '../../shared/constants/locales';
import { t } from '../../shared/constants/ui';
import Icon from '@/shared/components/design/Icon.astro';
import noImage from '@/assets/images/no-image.svg';

interface Props {
  lugar: ContenidoConRelaciones;
  categoria?: Categoria;
  lang?: Locale;
  /** Rango de fechas visible (p. ej. eventos): "1 - 15 Septiembre". */
  fecha?: string;
}

const { lugar, categoria, fecha } = Astro.props;
const lang: Locale = isLocale(Astro.props.lang) ? Astro.props.lang : 'es';
const href = localizePath(rutaContenido(lugar), lang);
const title = loc(lugar.data.title, lang) ?? lugar.id;
const description = loc(lugar.data.description, lang) ?? '';
const excerpt = loc(lugar.data.excerpt, lang) ?? description;
const zoneTitle = lugar.zone ? loc(lugar.zone.data.title, lang) : undefined;
const categoriaTitle = categoria ? loc(categoria.data.title, lang) : undefined;
const imagen = imagenSrc(lugar.data.image) || noImage.src;
---

<article
  class="card"
  data-lugar
  data-section="lugares"
  data-slug={lugar.id}
  data-categoria={lugar.collection}
  data-zona={lugar.zone?.id ?? ''}
  data-search={textoDeBusqueda(lugar, lang)}
>
  <div class="card__media">
    <img
      src={imagen}
      alt={title}
      loading="lazy"
      width="640"
      height="360"
    />
    {
      categoriaTitle && (
        <span class="card__badge badge badge--primary">
          <Icon name={COLLECTION_ICONS[lugar.collection] ?? 'pin'} size="sm" />
          <span class="card__badge-text">{categoriaTitle}</span>
        </span>
      )
    }
    {
      lugar.data.rating && (
        <span
          class="card__rating"
          aria-label={`Calificación: ${lugar.data.rating.toFixed(1)} de 5 estrellas`}
        >
          <Icon name="star" size="sm" />
          <span>{lugar.data.rating.toFixed(1)}</span>
        </span>
      )
    }
  </div>

  <div class="card__body">
    <h3 class="card__title">
      <a href={href}>{title}</a>
    </h3>
    <p class="card__meta">
      {
        fecha && (
          <span class="card__meta-item">
            <Icon name="calendar" size="sm" />
            {fecha}
          </span>
        )
      }
      {
        zoneTitle && (
          <span class="card__meta-item">
            <Icon name="pin" size="sm" />
            {zoneTitle}
          </span>
        )
      }
    </p>
    <p class="card__text">{excerpt}</p>
  </div>

  <div class="card__footer">
    <a class="card__link" href={href}>
      {t(lang, 'place.seePlace')}
      <span class="sr-only"> — {title}</span>
      <Icon name="arrow-right" size="sm" />
    </a>
    {
      lugar.data.verified && (
        <span class="badge badge--sun">
          <Icon name="check" size="sm" />
          {t(lang, 'place.verifiedBadge')}
        </span>
      )
    }
  </div>
</article>
