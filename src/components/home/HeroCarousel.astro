---
import Icon from '@/shared/components/design/Icon.astro';
import type { Props } from '@/shared/interfaces/hero.carousel';
import { t } from '@/shared/constants/ui';
import { getTumbesWeather } from '@/services/weather.service';
import { heroCampaignsService } from '@/services/hero-campaigns.service';
import '@/styles/components/hero-carousel.css';

const { lang, slides: propSlides } = Astro.props;

// Consulta en tiempo real a la API de Clima & Hora de Tumbes, Perú
const weather = await getTumbesWeather();

// Si se pasan slides por props se usan, sino se obtienen dinámicamente desde mitumbes-server (/hero)
const mcpCampaigns = (propSlides && propSlides.length > 0)
  ? propSlides
  : await heroCampaignsService.obtenerHeroSlides(lang);

const activeSlide = mcpCampaigns[0];

const iconMap: Record<string, string> = {
  place: 'pin',
  item: 'pin',
  category: 'tag',
  zone: 'waves',
  event: 'calendar',
  route: 'compass',
  custom: 'compass',
};
---

<section
  class="hero-main-wrapper"
  data-hero-container
  aria-label={t(lang, 'home.heroTitle')}
>
  <h1 class="sr-only">{t(lang, 'home.heroTitle')}</h1>

  <!-- ============================================================
       1. Barra Flotante de Clima & Hora en Vivo de Tumbes (API Open-Meteo)
       ============================================================ -->
  <div class="hero-live-status-bar" aria-label="Clima y Hora en Vivo de Tumbes, Perú">
    <div class="hero-live-status-inner">
      <!-- Hora en Vivo (America/Lima) -->
      <span class="hero-live-item" title="Hora local en Tumbes, Perú (GMT-5)">
        <Icon name="clock" size="sm" class="text-sun" />
        <strong data-live-clock-time>{weather.timeFormatted}</strong>
        <span class="text-white/60 text-xs hidden sm:inline">(GMT-5)</span>
      </span>

      <span class="hero-live-divider"></span>

      <!-- Clima y Temperatura en Vivo -->
      <span class="hero-live-item" title="Temperatura actual en Tumbes">
        <Icon name="sun" size="sm" class="text-amber-400" />
        <strong data-live-temp>{weather.temperature} °C</strong>
        <span class="text-white/80 hidden md:inline" data-live-condition>{weather.condition}</span>
      </span>

      <span class="hero-live-divider hidden sm:inline"></span>

      <!-- Humedad -->
      <span class="hero-live-item hidden sm:inline-flex" title="Humedad relativa en Tumbes">
        <Icon name="waves" size="sm" class="text-sky-300" />
        <span>Humedad: <strong data-live-humidity>{weather.humidity}%</strong></span>
      </span>

      <span class="hero-live-divider hidden lg:inline"></span>

      <!-- Viento -->
      <span class="hero-live-item hidden lg:inline-flex" title="Velocidad del viento">
        <Icon name="compass" size="sm" class="text-emerald-300" />
        <span>Viento: <strong data-live-wind>{weather.windSpeed} km/h</strong></span>
      </span>
    </div>
  </div>

  <!-- ============================================================
       2. Fondo Dinámico de Campaña Activa
       ============================================================ -->
  <div class="hero-camp-bg">
    <img
      id="hero-camp-bg-img"
      src={activeSlide.image}
      alt={activeSlide.title}
      class="hero-camp-bg__img"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-camp-bg__overlay"></div>
  </div>

  <!-- ============================================================
       3. Contenido Split-Screen (Copy Izquierdo + Panel Derecho)
       ============================================================ -->
  <div class="hero-camp-container">
    <div class="hero-camp-grid">
      
      <!-- Columna Izquierda: Copy de Campaña -->
      <div class="hero-camp-main">
        <span class="hero-camp-eyebrow" id="hero-camp-eyebrow">
          <Icon name={iconMap[activeSlide.entityType] || 'compass'} size="sm" />
          <span>{activeSlide.eyebrow}</span>
        </span>

        <h2 class="hero-camp-title" id="hero-camp-title">
          {activeSlide.title}
        </h2>

        <p class="hero-camp-desc" id="hero-camp-desc">
          {activeSlide.desc}
        </p>

        <div class="hero-camp-actions">
          <a class="btn-pill-action" id="hero-camp-cta" href={activeSlide.href}>
            <span id="hero-camp-cta-text">{activeSlide.ctaText || t(lang, 'place.seePlace')}</span>
            <Icon name="arrow-right" size="sm" />
          </a>
          <a class="btn-pill-ghost" href="#destinos">
            <Icon name="pin" size="sm" />
            <span>Ver Destinos Populares</span>
          </a>
        </div>
      </div>

      <!-- Columna Derecha: Panel Interactivo de Campañas - Diseño Ticket de Viaje / Boarding Pass -->
      <div class="hero-camp-panel">
        <div class="hero-camp-panel__inner ticket-panel">
          
          <!-- Encabezado del Ticket / Boarding Pass (Limpio y tipográfico, sin íconos pesados) -->
          <div class="ticket-header">
            <div class="ticket-header__left">
              <span class="ticket-header__eyebrow">PASE DE EMBARQUE</span>
              <h3 class="hero-camp-panel__title ticket-header__title">TICKET DE VIAJE • MI TUMBES</h3>
            </div>
            <div class="ticket-header__right">
              <span class="ticket-badge-class">CLASE VIP</span>
              <span class="ticket-gate">GATE TBP</span>
            </div>
          </div>

          <!-- Ruta Origen -> Destino del Ticket -->
          <div class="ticket-route">
            <div class="ticket-route__loc">
              <span class="ticket-route__tag">ORIGEN</span>
              <span class="ticket-route__code">TU RUTA</span>
              <span class="ticket-route__name">Perú & Mundo</span>
            </div>
            <div class="ticket-route__flight" aria-hidden="true">
              <div class="ticket-route__dotted"></div>
              <span class="ticket-route__num">EXP-2026</span>
            </div>
            <div class="ticket-route__loc ticket-route__loc--dest">
              <span class="ticket-route__tag">DESTINO</span>
              <span class="ticket-route__code">TBP</span>
              <span class="ticket-route__name">Tumbes Tropical</span>
            </div>
          </div>

          <!-- Selector de Experiencias / Campañas -->
          <div class="ticket-selector-wrap">
            <div class="ticket-selector-label">
              <span>EXPERIENCIAS SELECCIONABLES</span>
            </div>
            <div class="hero-camp-selector ticket-selector" role="tablist">
              {
                mcpCampaigns.map((c, idx) => (
                  <button
                    type="button"
                    class:list={['hero-camp-pill', 'ticket-pill', { 'hero-camp-pill--active': idx === 0 }]}
                    data-camp-btn={c.id}
                    data-type={c.entityType}
                    data-eyebrow={c.eyebrow}
                    data-title={c.title}
                    data-desc={c.desc}
                    data-status={c.status}
                    data-href={c.href}
                    data-image={c.image}
                    data-cta={c.ctaText || t(lang, 'place.seePlace')}
                    data-temp={c.metaTemp}
                    data-stat={c.metaStatus}
                    data-ops={c.metaOperators}
                    aria-label={`Ver campaña ${c.title}`}
                  >
                    <span class="ticket-pill__left">
                      <span class="ticket-pill__num">0{idx + 1}</span>
                      <span class="ticket-pill__title">{c.tag}</span>
                    </span>
                    <span class="ticket-pill__temp">{c.metaTemp}</span>
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Línea de Desprendimiento / Perforación con Muescas Laterales (Ticket Tear Line) -->
          <div class="ticket-tear" aria-hidden="true">
            <div class="ticket-notch ticket-notch--left"></div>
            <div class="ticket-tear__line"></div>
            <div class="ticket-notch ticket-notch--right"></div>
          </div>

          <!-- Talón del Ticket / Telemetría en Vivo -->
          <div class="ticket-stub">
            <div class="hero-camp-telemetry ticket-telemetry" aria-label="Telemetría de la experiencia en vivo">
              <div class="hero-camp-telemetry-item">
                <span class="hero-camp-telemetry-label">Clima / Temp</span>
                <span class="hero-camp-telemetry-val" id="hero-camp-telemetry-temp">{activeSlide.metaTemp}</span>
              </div>
              <div class="hero-camp-telemetry-item">
                <span class="hero-camp-telemetry-label">Condición / Estado</span>
                <span class="hero-camp-telemetry-val" id="hero-camp-telemetry-status">{activeSlide.metaStatus}</span>
              </div>
              <div class="hero-camp-telemetry-item">
                <span class="hero-camp-telemetry-label">Zona / Operadores</span>
                <span class="hero-camp-telemetry-val" id="hero-camp-telemetry-ops">{activeSlide.metaOperators}</span>
              </div>
            </div>

            <!-- Código de Barras y Estado en Vivo -->
            <div class="ticket-bottom">
              <div class="ticket-barcode-block">
                <div class="ticket-barcode" aria-hidden="true"></div>
                <span class="ticket-serial">MTB-TBP-2026-EXP</span>
              </div>
              <div class="hero-camp-footer-note ticket-footer-note">
                <span class="hero-camp-footer-live">
                  <span class="hero-camp-pulse-dot"></span>
                  <span id="hero-camp-status-text">{activeSlide.status}</span>
                </span>
                <span class="hero-camp-footer-badge" id="hero-camp-type-badge">
                  {activeSlide.entityType.toUpperCase()}
                </span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  import '@/scripts/hero-carousel.ts';
  import '@/scripts/weather-clock.ts';
</script>
