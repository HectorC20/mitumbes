---
import Layout from '@/components/layout/Layout.astro';
import Icon from '@/components/Icon.astro';
import PlaceCard from '@/components/place/PlaceCard.astro';
import HeroCarousel from '@/components/home/HeroCarousel.astro';
import noImage from '@/assets/images/no-image.svg';
import { lugaresService } from '@/services/lugares.service';
import { categoriasService } from '@/services/categorias.service';
import { conteosService } from '@/services/conteos.service';
import { clicksService } from '@/services/clicks.service';
import {
  imagenSrc,
  loc,
  rutaCategoria,
  rutaContenido,
} from '@/shared/content/places';
import {
  localizePath,
  type Locale,
} from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';
import { COLLECTION_ICONS } from '@/shared/constants/collections';
import '@/styles/pages/home.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// El home solo muestra categorías raíz (nivel 1 del backend). Las
// subcategorías se exploran dentro de cada página de categoría.
const [destacados, categorias, conteos] = await Promise.all([
  lugaresService.listarDestacados(6),
  categoriasService.listarRaices(),
  conteosService.obtener(),
]);

const categoriasPorId = new Map(categorias.map((c) => [c.collection, c]));

// Categorías del home: 4 con más clics + 2 al azar de las restantes (si la API
// responde con el ranking; si no, se mantiene el orden original).
const clicks = await clicksService.obtenerClicks();
const categoriasHome = clicksService.reordenarPorClics(categorias, clicks);

const carouselPlaces = destacados.slice(0, 5);
const fallbackHeroImg = noImage.src;
const heroImg =
  imagenSrc(carouselPlaces[0]?.data?.image) || fallbackHeroImg;

const heroSlides = carouselPlaces.map((item) => ({
  id: item.id,
  title: loc(item.data.title, lang) ?? '',
  subtitle: loc(item.data.excerpt, lang) ?? loc(item.data.description, lang) ?? '',
  eyebrow: item.zone ? loc(item.zone.data.title, lang) : undefined,
  image: imagenSrc(item.data.image) || fallbackHeroImg,
  href: localizePath(rutaContenido(item), lang),
}));

const lugaresHref = localizePath('/places/', lang);
const categoriasHref = localizePath('/categories/', lang);
---

<Layout lang={lang} title={t(lang, 'seo.homeTitle')} description={t(lang, 'seo.homeDescription')} image={heroImg}>
  <HeroCarousel slides={heroSlides} lang={lang} />

  <section class="section" id="categorias" data-section="categorias">
    <div class="container-page">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t(lang, 'home.categoriesEyebrow')}</p>
          <h2 class="section-head__title">{t(lang, 'home.categoriesTitle')}</h2>
        </div>
        <a class="section-head__link" href={categoriasHref}>
          {t(lang, 'home.viewAll')}
          <Icon name="arrow-right" size="sm" />
        </a>
      </div>
      <div class="category-grid">
        {
          categoriasHome.map((c) => (
            <a class="category-tile" href={localizePath(rutaCategoria(c.collection), lang)}>
              <span class="category-tile__icon">
                <Icon name={COLLECTION_ICONS[c.collection] ?? 'pin'} />
              </span>
              <span>
                <span class="category-tile__title">
                  {loc(c.data.title, lang)}
                </span>
                <span class="category-tile__count">
                  {conteos.porCategoria.get(c.collection) ?? 0} {t(lang, 'count.places')}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sand" id="destacados">
    <div class="container-page">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t(lang, 'home.featuredEyebrow')}</p>
          <h2 class="section-head__title">{t(lang, 'home.featuredTitle')}</h2>
        </div>
        <a class="section-head__link" href={lugaresHref}>
          {t(lang, 'home.viewAll')}
          <Icon name="arrow-right" size="sm" />
        </a>
      </div>
      <div class="place-grid">
        {
          destacados.map((lugar) => (
            <PlaceCard
              lugar={lugar}
              categoria={categoriasPorId.get(lugar.collection)}
              lang={lang}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
