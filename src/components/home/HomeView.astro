---
import Layout from '@/components/layout/Layout.astro';
import Icon from '@/shared/components/design/Icon.astro';
import PlaceCard from '@/components/place/PlaceCard.astro';
import HeroCarousel from '@/components/home/HeroCarousel.astro';
import PopularDestinations from '@/components/home/PopularDestinations.astro';
import HomeCategories from '@/components/home/HomeCategories.astro';
import AdBanner from '@/shared/components/ads/AdBanner.astro';
import PartnerList from '@/components/partner/PartnerList.astro';
import noImage from '@/assets/images/no-image.svg';
import { contentService } from '@/services/content.service';
import {
  imagenSrc,
} from '@/shared/content/places';
import {
  localizePath,
  type Locale,
} from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';
import HomeGuide from '@/components/home/HomeGuide.astro';
import HomeEvents from '@/components/home/HomeEvents.astro';
import SectionChunk from '@/components/common/SectionChunk.astro';
import '@/styles/pages/home.css';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

// El home muestra categorías raíz, zonas geográficas y lugares destacados.
const [destacados, categorias, zonas, conteos] = await Promise.all([
  contentService.lugares.listarDestacados(6),
  contentService.categorias.listarRaices(),
  contentService.zonas.listar(),
  contentService.conteos.obtener(),
]);

const categoriasPorId = new Map(categorias.map((c) => [c.collection, c]));

const carouselPlaces = destacados.slice(0, 5);
const fallbackHeroImg = noImage.src;
const heroImg =
  imagenSrc(carouselPlaces[0]?.data?.image) || fallbackHeroImg;

const lugaresHref = localizePath('/places/', lang);
const partnersHref = localizePath('/partners/', lang);
---

<Layout lang={lang} title={t(lang, 'seo.homeTitle')} description={t(lang, 'seo.homeDescription')} image={heroImg}>
  <!-- 1. Hero principal dinámico conectado con mitumbes-server/MCP -->
  <HeroCarousel lang={lang} />

  <!-- 1.1 Banner publicitario minimalista en el apartado inicial -->
  <AdBanner lang={lang} />

  <!-- 2. Apartado de Destinos Populares (3D Coverflow inspirado en diseño top travel) -->
  <PopularDestinations zonas={zonas} conteos={conteos.porZona} lang={lang} />

  <!-- 3. Categorías principales dinámicas e inspiracionales -->
  <HomeCategories categorias={categorias} conteos={conteos.porCategoria} lang={lang} />

  <!-- 4. Lugares Destacados (Diseño moderno alineado con el estándar de la home) -->
  <SectionChunk id="destacados" class="section section--sand featured-places-section" minHeight="760px">
    <div class="container-page">
      
      <!-- Encabezado moderno unificado con el estándar de la home -->
      <div class="featured-places__head">
        <div class="featured-places__head-left">
          <span class="featured-places__badge">
            <Icon name="star" size="sm" class="text-amber-500" />
            <span>{t(lang, 'home.featuredEyebrow')}</span>
          </span>
          <h2 class="featured-places__title">{t(lang, 'home.featuredTitle')}</h2>
          <p class="featured-places__subtitle">
            {lang === 'en'
              ? 'Handpicked travel experiences with verified access, beach conditions, ecological reserves, and local cuisine.'
              : 'Selección de experiencias imprescindibles con rutas de acceso verificadas, playas tranquilas, reservas ecológicas y auténtica gastronomía norteña.'}
          </p>
        </div>
        <a class="featured-places__view-all" href={lugaresHref}>
          <span>{t(lang, 'search.viewAllPlaces')}</span>
          <Icon name="arrow-right" size="sm" />
        </a>
      </div>

      <!-- Barra de atributos rápidos -->
      <div class="featured-places__meta-strip" aria-label="Características destacadas">
        <span class="featured-places__meta-item">
          <Icon name="badge-check" size="sm" class="text-primary" />
          <span>Fichas 100% Verificadas</span>
        </span>
        <span class="featured-places__meta-item">
          <Icon name="sun" size="sm" class="text-amber-500" />
          <span>Litoral Cálido Todo el Año</span>
        </span>
        <span class="featured-places__meta-item">
          <Icon name="pin" size="sm" class="text-rose-500" />
          <span>Rutas desde Aeropuerto y Terminales</span>
        </span>
      </div>

      <!-- Parrilla de Tarjetas -->
      <div class="place-grid">
        {
          destacados.map((lugar) => (
            <PlaceCard
              lugar={lugar}
              categoria={categoriasPorId.get(lugar.collection)}
              lang={lang}
            />
          ))
        }
      </div>

      <!-- Banner de Exploración y Búsqueda -->
      <div class="featured-places__footer-banner">
        <div class="featured-places__footer-text">
          <h3 class="featured-places__footer-title">
            {lang === 'en' ? 'Looking for a specific attraction or beach?' : '¿Buscas una playa, restaurante o actividad en específico?'}
          </h3>
          <p class="featured-places__footer-desc">
            {lang === 'en'
              ? 'Filter our full directory by zones, categories, or search by keywords with instant results.'
              : 'Explora nuestro directorio completo con buscador en tiempo real, filtros por zona y categorías gastronómicas.'}
          </p>
        </div>
        <a class="featured-places__footer-btn" href={lugaresHref}>
          <Icon name="search" size="sm" />
          <span>{lang === 'en' ? 'Explore Full Catalog' : 'Explorar Todo el Catálogo'}</span>
        </a>
      </div>

    </div>
  </SectionChunk>

  <!-- 5. Apartado de Eventos y Agenda Cultural -->
  <HomeEvents lang={lang} />

  <!-- 6. Guía editorial de la región -->
  <HomeGuide lang={lang} />

  <!-- 6. Directorio de Partners / Aliados -->
  <SectionChunk id="partners" class="section" minHeight="380px" data-section="partners">
    <div class="container-page">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t(lang, 'partners.eyebrow')}</p>
          <h2 class="section-head__title">{t(lang, 'seo.partnersTitle')}</h2>
        </div>
        <a class="section-head__link" href={partnersHref}>
          {t(lang, 'partners.viewAll')}
          <Icon name="arrow-right" size="sm" />
        </a>
      </div>
      <PartnerList lang={lang} />
    </div>
  </SectionChunk>
</Layout>

<script>
  import '@/scripts/chunk-loader';
</script>
