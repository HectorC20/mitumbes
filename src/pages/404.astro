---
import Layout from '../components/layout/Layout.astro';
import Icon from '../components/Icon.astro';
import {
  getLocaleFromPath,
  localizePath,
  type Locale,
} from '../shared/constants/locales';
import { t } from '../shared/constants/ui';

// Servida en runtime para detectar el idioma de la URL y responder 404.
export const prerender = false;

const lang: Locale = getLocaleFromPath(Astro.url.pathname);
---

<Layout
  lang={lang}
  title={t(lang, 'seo.notFoundTitle')}
  description={t(lang, 'seo.notFoundDescription')}
  noindex
>
  <section class="section section--sand">
    <div class="container-page text-center">
      <p class="font-display text-7xl text-primary">404</p>
      <h1 class="page-title">{t(lang, 'notFound.title')}</h1>
      <p class="lead mx-auto">{t(lang, 'notFound.lead')}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn--primary" href={localizePath('/', lang)}>
          <Icon name="compass" size="sm" />
          {t(lang, 'notFound.goHome')}
        </a>
        <a class="btn btn--outline" href={localizePath('/lugares/', lang)}>
          <Icon name="pin" size="sm" />
          {t(lang, 'notFound.explorePlaces')}
        </a>
      </div>
    </div>
  </section>
</Layout>
