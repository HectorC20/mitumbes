---
import HomeView from '@/components/home/HomeView.astro';
import { DEFAULT_LOCALE, isLocale, type Locale } from '@/shared/constants/locales';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

// El idioma por defecto (es) vive en la raíz (/), así que /es/ redirige ahí
// para evitar contenido duplicado y consolidar el canonical.
if (lang === DEFAULT_LOCALE) {
  return Astro.redirect('/', 301);
}
---

<HomeView lang={lang} />
