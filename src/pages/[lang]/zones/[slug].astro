---
import Layout from '@/components/layout/Layout.astro';
import PlaceCard from '@/components/place/PlaceCard.astro';
import { zonasService } from '@/services/zonas.service';
import { categoriasService } from '@/services/categorias.service';
import { imagenSrc, loc } from '@/shared/content/places';
import { breadcrumbJsonLd } from '@/lib/seo/jsonld';
import { localizePath, isLocale, type Locale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';
import '@/styles/pages/zona.css';

const lang = Astro.params.lang as Locale;
const { slug } = Astro.params;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const zona = await zonasService.buscarPorId(slug!);

if (!zona) {
  return Astro.redirect(`/${lang}/404/`);
}

const [contenidos, categorias] = await Promise.all([
  zonasService.listarLugares(slug!),
  categoriasService.listar(),
]);

const categoriasPorId = new Map(categorias.map((c) => [c.collection, c]));
const title = loc(zona.data.title, lang) ?? zona.id;
const description = loc(zona.data.description, lang) ?? '';

const breadcrumbs = [
  { name: t(lang, 'nav.home'), url: localizePath('/', lang) },
  { name: t(lang, 'nav.zones'), url: localizePath('/zones/', lang) },
  { name: title },
];
---

<Layout
  lang={lang}
  title={`${title} — Tumbes`}
  description={description}
  image={imagenSrc(zona.data.image)}
  jsonLd={breadcrumbJsonLd(breadcrumbs)}
>
  <nav class="container-page breadcrumbs" aria-label={t(lang, 'nav.home')}>
    <ol class="breadcrumbs__list">
      {
        breadcrumbs.map((item, i) => (
          <>
            {i > 0 && <li class="breadcrumbs__sep" aria-hidden="true">/</li>}
            {
              item.url ? (
                <li>
                  <a class="breadcrumbs__link" href={item.url}>
                    {item.name}
                  </a>
                </li>
              ) : (
                <li aria-current="page">{item.name}</li>
              )
            }
          </>
        ))
      }
    </ol>
  </nav>

  {
    zona.data.image ? (
      <section class="zona-hero">
        <img class="zona-hero__img" src={imagenSrc(zona.data.image)} alt={t(lang, 'zones.imageAlt').replace('{zone}', title)} />
        <div class="zona-hero__overlay"></div>
        <div class="zona-hero__inner">
          <h1 class="zona-hero__title">
            {title}
          </h1>
        </div>
      </section>
    ) : (
      <section class="section section--sand">
        <div class="container-page">
          <h1 class="page-title">{title}</h1>
        </div>
      </section>
    )
  }

  {
    zona.data.image && (
      <section class="section">
        <div class="container-page">
          <p class="lead">{description}</p>
        </div>
      </section>
    )
  }

  <section class="section zona-list">
    <div class="container-page">
      <p class="search-meta">
        {contenidos.length} {contenidos.length === 1 ? t(lang, 'count.place') : t(lang, 'count.places')} {t(lang, 'count.in')} {title}
      </p>
      {
        contenidos.length > 0 ? (
          <div class="place-grid">
            {
              contenidos.map((lugar) => (
                <PlaceCard
                  lugar={lugar}
                  categoria={categoriasPorId.get(lugar.collection)}
                  lang={lang}
                />
              ))
            }
          </div>
        ) : (
          <div class="empty-state">
            <p class="empty-state__title">
              {t(lang, 'zones.emptyTitle')}
            </p>
            <p class="empty-state__body">{t(lang, 'zones.emptyBody')}</p>
          </div>
        )
      }
    </div>
  </section>
</Layout>
