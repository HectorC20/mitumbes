---
import Layout from '@/components/layout/Layout.astro';
import PlaceList from '@/components/place/PlaceList.astro';
import AdBanner from '@/shared/components/ads/AdBanner.astro';
import { contentService } from '@/services/content.service';
import { imagenSrc, loc } from '@/shared/content/places';
import { breadcrumbJsonLd } from '@/lib/seo/jsonld';
import { localizePath, isLocale, type Locale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';

const lang = Astro.params.lang as Locale;
const { slug } = Astro.params;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const zona = await contentService.zonas.buscarPorId(slug!);

if (!zona) {
  return Astro.redirect(`/${lang}/404/`);
}

const search = Astro.url.searchParams;
const pagina = Number.parseInt(search.get('page') ?? '1', 10);
const paginaActual = Number.isNaN(pagina) || pagina < 1 ? 1 : pagina;

const [listado, categorias] = await Promise.all([
  contentService.lugares.listarPagina({ zona: slug! }, paginaActual),
  contentService.categorias.listar(),
]);

const title = loc(zona.data.title, lang) ?? zona.id;
const description = loc(zona.data.description, lang) ?? '';

const countLabel = `${listado.total} ${listado.total === 1 ? t(lang, 'count.place') : t(lang, 'count.places')} ${t(lang, 'count.in')} ${title}`;

const breadcrumbs = [
  { name: t(lang, 'nav.home'), url: localizePath('/', lang) },
  { name: t(lang, 'nav.zones'), url: localizePath('/zones/', lang) },
  { name: title },
];
---

<Layout
  lang={lang}
  title={`${title} — Tumbes`}
  description={description}
  image={imagenSrc(zona.data.image)}
  jsonLd={breadcrumbJsonLd(breadcrumbs)}
>
  <nav class="container-page breadcrumbs" aria-label={t(lang, 'nav.home')}>
    <ol class="breadcrumbs__list">
      {
        breadcrumbs.map((item, i) => (
          <>
            {i > 0 && <li class="breadcrumbs__sep" aria-hidden="true">/</li>}
            {
              item.url ? (
                <li>
                  <a class="breadcrumbs__link" href={item.url}>
                    {item.name}
                  </a>
                </li>
              ) : (
                <li aria-current="page">{item.name}</li>
              )
            }
          </>
        ))
      }
    </ol>
  </nav>

  {
    zona.data.image ? (
      <section class="zona-hero">
        <img class="zona-hero__img" src={imagenSrc(zona.data.image)} alt={t(lang, 'zones.imageAlt').replace('{zone}', title)} />
        <div class="zona-hero__overlay"></div>
        <div class="zona-hero__inner">
          <h1 class="zona-hero__title">
            {title}
          </h1>
        </div>
      </section>
    ) : (
      <section class="section section--sand">
        <div class="container-page">
          <h1 class="page-title">{title}</h1>
        </div>
      </section>
    )
  }

  {
    zona.data.image && (
      <section class="section">
        <div class="container-page">
          <p class="lead">{description}</p>
        </div>
      </section>
    )
  }

  <AdBanner lang={lang} id={`zone-${slug}-ad`} variant="card" />

  <section class="section pt-0">
    <div class="container-page">
      <PlaceList
        lugares={listado.items}
        categorias={categorias}
        page={listado.page}
        totalPaginas={listado.totalPaginas}
        lang={lang}
        countLabel={countLabel}
        emptyTitle={t(lang, 'zones.emptyTitle')}
        emptyBody={t(lang, 'zones.emptyBody')}
      />
    </div>
  </section>
</Layout>
