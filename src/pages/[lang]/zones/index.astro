---
import Layout from '@/components/layout/Layout.astro';
import { imagenSrc, loc } from '@/shared/content/places';
import { zonasService } from '@/services/zonas.service';
import { conteosService } from '@/services/conteos.service';
import { localizePath, type Locale, isLocale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';
import '@/styles/pages/home.css';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const [zonas, conteos] = await Promise.all([
  zonasService.listar(),
  conteosService.obtener(),
]);
---

<Layout lang={lang} title={t(lang, 'seo.zonesTitle')} description={t(lang, 'seo.zonesDescription')}>
  <section class="section section--sand">
    <div class="container-page">
      <p class="eyebrow">{t(lang, 'zones.eyebrow')}</p>
      <h1 class="page-title">{t(lang, 'seo.zonesTitle')}</h1>
      <p class="lead">{t(lang, 'zones.lead')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="zone-grid">
        {
          zonas.map((z) => (
            <a
              class="zone-card"
              data-section="zonas"
              data-id={z.id}
              href={localizePath(`/zones/${z.id}/`, lang)}
            >
              {
                z.data.image && (
                  <img class="zone-card__img" src={imagenSrc(z.data.image)} alt={t(lang, 'zones.imageAlt').replace('{zone}', loc(z.data.title, lang) ?? z.id)} loading="lazy" />
                )
              }
              <div class="zone-card__body">
                <p class="zone-card__title">{loc(z.data.title, lang)}</p>
                <p class="zone-card__count">
                  {conteos.porZona.get(z.id) ?? 0} {t(lang, 'count.places')}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
