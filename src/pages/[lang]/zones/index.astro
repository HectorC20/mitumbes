---
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import ZoneCard from '@/components/zone/ZoneCard.astro';
import AdBanner from '@/shared/components/ads/AdBanner.astro';
import { contentService } from '@/services/content.service';
import { type Locale, isLocale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const [zonas, conteos] = await Promise.all([
  contentService.zonas.listar(),
  contentService.conteos.obtener(),
]);
---

<Layout lang={lang} title={t(lang, 'seo.zonesTitle')} description={t(lang, 'seo.zonesDescription')}>
  <PageHeader
    eyebrow={t(lang, 'zones.eyebrow')}
    title={t(lang, 'seo.zonesTitle')}
    lead={t(lang, 'zones.lead')}
  />

  <AdBanner lang={lang} id="zones-index-ad" variant="card" />

  <section class="section">
    <div class="container-page">
      <div class="dest-track-container">
        <div class="zone-grid">
          {
            zonas.map((z) => (
              <ZoneCard
                zona={z}
                count={conteos.porZona.get(z.id) ?? 0}
                lang={lang}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>
