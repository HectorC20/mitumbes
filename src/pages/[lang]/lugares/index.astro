---
import Layout from '../../../components/layout/Layout.astro';
import PlaceSearch from '../../../components/search/PlaceSearch.astro';
import {
  getAllContenidos,
  getCategorias,
  getZonas,
  filtrarContenidos,
  type FiltroContenidos,
} from '../../../shared/content/places';
import { LOCALES, type Locale } from '../../../shared/constants/locales';
import { t } from '../../../shared/constants/ui';

export async function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

export const prerender = true;

const lang = Astro.params.lang as Locale;
const params = Object.fromEntries(Astro.url.searchParams) as FiltroContenidos;

const [todos, categorias, zonas] = await Promise.all([
  getAllContenidos(),
  getCategorias(),
  getZonas(),
]);

const filtrados = filtrarContenidos(todos, params, lang);
---

<Layout lang={lang} title={t(lang, 'seo.placesTitle')} description={t(lang, 'seo.placesDescription')}>
  <section class="section section--sand">
    <div class="container-page">
      <p class="eyebrow">{t(lang, 'categories.eyebrow')}</p>
      <h1 class="page-title">{t(lang, 'seo.placesTitle')}</h1>
      <p class="lead">{t(lang, 'seo.placesDescription')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <PlaceSearch
        lugares={filtrados}
        categorias={categorias}
        zonas={zonas}
        params={params}
        lang={lang}
      />
    </div>
  </section>
</Layout>
