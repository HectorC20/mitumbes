---
import Layout from '@/components/layout/Layout.astro';
import PlaceSearch from '@/components/search/PlaceSearch.astro';
import { lugaresService } from '@/services/lugares.service';
import { categoriasService } from '@/services/categorias.service';
import { zonasService } from '@/services/zonas.service';
import type { FiltroContenidos } from '@/shared/content/places';
import { type Locale, isLocale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const params = Object.fromEntries(Astro.url.searchParams) as FiltroContenidos;

const [todos, categorias, zonas] = await Promise.all([
  lugaresService.listarTodos(),
  categoriasService.listar(),
  zonasService.listar(),
]);

const filtrados = lugaresService.filtrar(todos, params, lang);
---

<Layout lang={lang} title={t(lang, 'seo.placesTitle')} description={t(lang, 'seo.placesDescription')}>
  <section class="section section--sand">
    <div class="container-page">
      <p class="eyebrow">{t(lang, 'categories.eyebrow')}</p>
      <h1 class="page-title">{t(lang, 'seo.placesTitle')}</h1>
      <p class="lead">{t(lang, 'seo.placesDescription')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <PlaceSearch
        lugares={filtrados}
        categorias={categorias}
        zonas={zonas}
        params={params}
        lang={lang}
      />
    </div>
  </section>
</Layout>
