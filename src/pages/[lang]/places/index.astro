---
import Layout from '@/components/layout/Layout.astro';
import PlaceSearch from '@/components/search/PlaceSearch.astro';
import { lugaresService } from '@/services/lugares.service';
import { categoriasService } from '@/services/categorias.service';
import { zonasService } from '@/services/zonas.service';
import type { FiltroContenidos } from '@/shared/content/places';
import { type Locale, isLocale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const search = Astro.url.searchParams;
const filtro: FiltroContenidos = {
  q: search.get('q') ?? undefined,
  categoria: search.get('categoria') ?? undefined,
  zona: search.get('zona') ?? undefined,
};
const page = Number.parseInt(search.get('page') ?? '1', 10);

// El filtro, el orden y el troceado a 20 por página los resuelve el backend.
const [listado, categorias, zonas] = await Promise.all([
  lugaresService.listarPagina(filtro, Number.isNaN(page) ? 1 : page),
  categoriasService.listarRaices(),
  zonasService.listar(),
]);
---

<Layout lang={lang} title={t(lang, 'seo.placesTitle')} description={t(lang, 'seo.placesDescription')}>
  <section class="section section--sand">
    <div class="container-page">
      <p class="eyebrow">{t(lang, 'categories.eyebrow')}</p>
      <h1 class="page-title">{t(lang, 'seo.placesTitle')}</h1>
      <p class="lead">{t(lang, 'seo.placesDescription')}</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <PlaceSearch
        lugares={listado.items}
        categorias={categorias}
        zonas={zonas}
        params={filtro}
        total={listado.total}
        page={listado.page}
        totalPaginas={listado.totalPaginas}
        lang={lang}
      />
    </div>
  </section>
</Layout>
