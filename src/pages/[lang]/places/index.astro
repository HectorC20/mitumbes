---
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PlaceSearch from '@/components/search/PlaceSearch.astro';
import AdBanner from '@/shared/components/ads/AdBanner.astro';
import { contentService } from '@/services/content.service';
import type { FiltroContenidos } from '@/shared/content/places';
import { type Locale, isLocale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const search = Astro.url.searchParams;
const filtro: FiltroContenidos = {
  q: search.get('q') ?? undefined,
  categoria: search.get('categoria') ?? undefined,
  zona: search.get('zona') ?? undefined,
};
const page = Number.parseInt(search.get('page') ?? '1', 10);

// El filtro, el orden y el troceado a 12 por página los resuelve el backend.
const [listado, categorias, zonas, catPlaces] = await Promise.all([
  contentService.lugares.listarPagina(filtro, Number.isNaN(page) ? 1 : page),
  contentService.categorias.listarRaices(),
  contentService.zonas.listar(),
  contentService.categorias.buscarPorId('places'),
]);
---

<Layout lang={lang} title={t(lang, 'seo.placesTitle')} description={t(lang, 'seo.placesDescription')}>
  <PageHeader
    eyebrow={t(lang, 'categories.eyebrow')}
    title={t(lang, 'seo.placesTitle')}
    lead={t(lang, 'seo.placesDescription')}
    image={catPlaces?.data.image}
  />

  <AdBanner lang={lang} id="places-catalog-ad" variant="minimal" />

  <section class="section">
    <div class="container-page">
      <PlaceSearch
        lugares={listado.items}
        categorias={categorias}
        zonas={zonas}
        params={filtro}
        total={listado.total}
        page={listado.page}
        totalPaginas={listado.totalPaginas}
        lang={lang}
      />
    </div>
  </section>
</Layout>
