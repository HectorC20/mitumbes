---
import Layout from '@/components/layout/Layout.astro';
import LegalDocument from '@/components/legal/LegalDocument.astro';
import { isLocale, type Locale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';
import { codeOfEthicsData } from '@/shared/content/legal-data';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}
---

<Layout
  lang={lang}
  title={t(lang, 'seo.ethicsTitle')}
  description={t(lang, 'seo.ethicsDescription')}
>
  <LegalDocument
    document={codeOfEthicsData}
    lang={lang}
    eyebrow={t(lang, 'ethics.eyebrow')}
    title={t(lang, 'ethics.title')}
    lead={t(lang, 'ethics.lead')}
    updatedText={t(lang, 'ethics.updated')}
  />
</Layout>
