---
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PartnerList from '@/components/partner/PartnerList.astro';
import AdBanner from '@/shared/components/ads/AdBanner.astro';
import { isLocale, type Locale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}
---

<Layout
  lang={lang}
  title={t(lang, 'seo.partnersTitle')}
  description={t(lang, 'seo.partnersDescription')}
>
  <PageHeader
    eyebrow={t(lang, 'partners.eyebrow')}
    title={t(lang, 'seo.partnersTitle')}
    lead={t(lang, 'partners.lead')}
  />

  <section class="section">
    <div class="container-page">
      <PartnerList lang={lang} />
    </div>
  </section>

  <AdBanner lang={lang} id="partners-page-ad" variant="billboard" />
</Layout>
