---
import Layout from '@/components/layout/Layout.astro';
import LegalDocument from '@/components/legal/LegalDocument.astro';
import { isLocale, type Locale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';
import { privacyPolicyData } from '@/shared/content/legal-data';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}
---

<Layout
  lang={lang}
  title={t(lang, 'seo.privacyTitle')}
  description={t(lang, 'seo.privacyDescription')}
>
  <LegalDocument
    document={privacyPolicyData}
    lang={lang}
    eyebrow={t(lang, 'privacy.eyebrow')}
    title={t(lang, 'privacy.title')}
    lead={t(lang, 'privacy.lead')}
    updatedText={t(lang, 'privacy.updated')}
  />
</Layout>
