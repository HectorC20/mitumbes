---
import Layout from '@/components/layout/Layout.astro';
import Icon from '@/components/Icon.astro';
import PlaceCard from '@/components/place/PlaceCard.astro';
import { loc, imagenSrc } from '@/shared/content/places';
import { categoriasService } from '@/services/categorias.service';
import { lugaresService } from '@/services/lugares.service';
import { zonasService } from '@/services/zonas.service';
import { conteosService } from '@/services/conteos.service';
import { breadcrumbJsonLd } from '@/lib/seo/jsonld';
import { localizePath, isLocale, type Locale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';
import { COLLECTION_ICONS } from '@/shared/constants/collections';
import { clicksService } from '@/services/clicks.service';
import type { ContenidoConRelaciones } from '@/shared/content/places';
import '@/styles/pages/home.css';

const lang = Astro.params.lang as Locale;
const { slug } = Astro.params;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const [categoria, subcategorias, zonas, conteos, categoriasTodas] = await Promise.all([
  categoriasService.buscarPorId(slug!),
  categoriasService.listarSubcategorias(slug!),
  zonasService.listar(),
  conteosService.obtener(),
  categoriasService.listar(),
]);

if (!categoria) {
  return Astro.redirect(`/${lang}/404/`);
}

// Ranking por clics (SSR): entrar a la categoría equivale a un "clic" en el
// home; se suma 1 al ranking de Vercel KV para reordenar la lista de 6.
await clicksService.registrarVistaCategoria(slug!);

const esRaiz = !categoria.data.parent;
// "zones" es una categoría raíz del backend; sus zonas geográficas se
// muestran como agrupación (atributo de los lugares), no como contenidos.
const esSeccionZonas = slug === 'zones';
const icono =
  categoria.data.icon ??
  COLLECTION_ICONS[slug as keyof typeof COLLECTION_ICONS] ??
  'pin';

// Contenidos: raíz → por categoría; subcategoría → por subcategoría hoja.
let contenidos: ContenidoConRelaciones[] = [];
if (!esSeccionZonas) {
  contenidos = esRaiz
    ? await lugaresService.listarPorCategoria(slug as never)
    : await lugaresService.listarPorSubcategoria(slug!);
}

const title = loc(categoria.data.title, lang) ?? slug!;
const description = loc(categoria.data.description, lang) ?? '';

const categoriaPadre = categoria.data.parent
  ? categoriasTodas.find((c) => c.collection === categoria.data.parent)
  : undefined;

const breadcrumbs = [
  { name: t(lang, 'nav.home'), url: localizePath('/', lang) },
  { name: t(lang, 'nav.categories'), url: localizePath('/categories/', lang) },
  ...(categoriaPadre
    ? [
        {
          name: loc(categoriaPadre.data.title, lang) ?? categoria.data.parent ?? slug!,
          url: localizePath(`/categories/${categoria.data.parent}/`, lang),
        },
      ]
    : []),
  { name: title },
];
---

<Layout
  lang={lang}
  title={`${title} ${t(lang, 'categories.inTumbes')}`}
  description={description}
  jsonLd={breadcrumbJsonLd(breadcrumbs)}
>
  <nav class="container-page breadcrumbs" aria-label={t(lang, 'nav.home')}>
    <ol class="breadcrumbs__list">
      {
        breadcrumbs.map((item, i) => (
          <>
            {i > 0 && <li class="breadcrumbs__sep" aria-hidden="true">/</li>}
            {
              item.url ? (
                <li>
                  <a class="breadcrumbs__link" href={item.url}>
                    {item.name}
                  </a>
                </li>
              ) : (
                <li aria-current="page">{item.name}</li>
              )
            }
          </>
        ))
      }
    </ol>
  </nav>

  <section class="section section--sand">
    <div class="container-page">
      <div class="categoria-header">
        <span class="category-tile__icon">
          <Icon name={icono} size="lg" />
        </span>
        <div>
          <h1 class="page-title">{title} {t(lang, 'categories.inTumbes')}</h1>
          <p class="lead">{description}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Subcategorías (nivel 2 del backend) de una categoría raíz. -->
  {
    subcategorias.length > 0 && (
      <section class="section">
        <div class="container-page">
          <div class="category-grid">
            {
              subcategorias.map((sub) => (
                <a
                  class="category-tile"
                  data-section="subcategorias"
                  data-id={sub.collection}
                  href={localizePath(`/categories/${sub.collection}/`, lang)}
                >
                  <span class="category-tile__icon">
                    <Icon name={COLLECTION_ICONS[sub.collection] ?? 'pin'} />
                  </span>
                  <span>
                    <span class="category-tile__title">{loc(sub.data.title, lang)}</span>
                    <span class="category-tile__count">
                      {conteos.porSubcategoria.get(sub.collection) ?? 0} {t(lang, 'count.places')}
                    </span>
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- "zones": las zonas geográficas se muestran como agrupación de lugares
       (atributo del contenido), no como una colección propia. -->
  {
    esSeccionZonas ? (
      <section class="section">
        <div class="container-page">
          <div class="zone-grid">
            {
              zonas.map((z) => (
                <a
                  class="zone-card"
                  data-section="zonas"
                  data-id={z.id}
                  href={localizePath(`/zones/${z.id}/`, lang)}
                >
                  {
                    z.data.image && (
                      <img
                        class="zone-card__img"
                        src={imagenSrc(z.data.image)}
                        alt={t(lang, 'zones.imageAlt').replace('{zone}', loc(z.data.title, lang) ?? z.id)}
                        loading="lazy"
                      />
                    )
                  }
                  <div class="zone-card__body">
                    <p class="zone-card__title">{loc(z.data.title, lang)}</p>
                    <p class="zone-card__count">
                      {conteos.porZona.get(z.id) ?? 0} {t(lang, 'count.places')}
                    </p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container-page">
          <p class="search-meta">
            {contenidos.length} {contenidos.length === 1 ? t(lang, 'count.place') : t(lang, 'count.places')}
          </p>
          {
            contenidos.length > 0 ? (
              <div class="place-grid">
                {
                  contenidos.map((lugar) => (
                    <PlaceCard lugar={lugar} categoria={categoria} lang={lang} />
                  ))
                }
              </div>
            ) : (
              <div class="empty-state">
                <p class="empty-state__title">
                  {t(lang, 'categories.emptyTitle')}
                </p>
                <p class="empty-state__body">{t(lang, 'categories.emptyBody')}</p>
              </div>
            )
          }
        </div>
      </section>
    )
  }
</Layout>
