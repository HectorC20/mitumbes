---
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import PlaceList from '@/components/place/PlaceList.astro';
import AdBanner from '@/shared/components/ads/AdBanner.astro';
import EventCalendarFilter from '@/components/events/EventCalendarFilter.astro';
import CategoryFilterBar from '@/components/category/CategoryFilterBar.astro';
import CategoryCard from '@/components/category/CategoryCard.astro';
import ZoneCard from '@/components/zone/ZoneCard.astro';
import { loc } from '@/shared/content/places';
import type { PaginaListado } from '@/shared/content/places';
import { fechaEvento } from '@/shared/content/eventos';
import { contentService } from '@/services/content.service';
import { eventosService } from '@/services/eventos.service';
import { breadcrumbJsonLd } from '@/lib/seo/jsonld';
import { localizePath, isLocale, type Locale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';
import { COLLECTION_ICONS } from '@/shared/constants/collections';
import { clicksService } from '@/services/clicks.service';

const lang = Astro.params.lang as Locale;
const { slug } = Astro.params;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const [categoria, subcategorias, zonas, categoriasTodas] = await Promise.all([
  contentService.categorias.buscarPorId(slug!),
  contentService.categorias.listarSubcategorias(slug!),
  contentService.zonas.listar(),
  contentService.categorias.listar(),
]);

if (!categoria) {
  return Astro.redirect(`/${lang}/404/`);
}

// Ranking por clics (SSR): entrar a la categoría equivale a un "clic" en el
// home; se suma 1 al ranking de Vercel KV para reordenar la lista de 6.
await clicksService.registrarVistaCategoria(slug!);

const esRaiz = !categoria.data.parent;
// "zones" es una categoría raíz del backend; sus zonas geográficas se
// muestran como agrupación (atributo de los lugares), no como contenidos.
const esSeccionZonas = slug === 'zones';
const esEventos = slug === 'events';
const icono =
  categoria.data.icon ??
  COLLECTION_ICONS[slug as keyof typeof COLLECTION_ICONS] ??
  'pin';

// Conteos solo si hay tarjetas de subcategoría o de zona que mostrar (evita
// pedir el catálogo completo en páginas que no los usan).
const conteos =
  subcategorias.length > 0 || esSeccionZonas
    ? await contentService.conteos.obtener()
    : { porCategoria: new Map(), porSubcategoria: new Map(), porZona: new Map() };

const search = Astro.url.searchParams;
const pagina = Number.parseInt(search.get('page') ?? '1', 10);
const paginaActual = Number.isNaN(pagina) || pagina < 1 ? 1 : pagina;

const qParam = search.get('q')?.trim() || undefined;
const subcategoriaParam = search.get('subcategoria')?.trim() || undefined;
const zonaParam = search.get('zona')?.trim() || undefined;

// Calendario de eventos: mes y año viajan como query (mes=9&anio=2026).
const mesNum = Number.parseInt(search.get('mes') ?? '', 10);
const anioNum = Number.parseInt(search.get('anio') ?? '', 10);
const mesCalendario =
  esEventos && !Number.isNaN(mesNum) && !Number.isNaN(anioNum)
    ? `${anioNum}-${String(mesNum).padStart(2, '0')}`
    : undefined;

// Listado paginado según el tipo de página: eventos (con calendario),
// categoría raíz o subcategoría hoja (backend pagination).
let listado: PaginaListado = {
  items: [],
  total: 0,
  page: paginaActual,
  totalPaginas: 1,
};
if (!esSeccionZonas) {
  if (esEventos) {
    listado = await eventosService.listarPagina({ mes: mesCalendario }, paginaActual);
  } else if (esRaiz) {
    listado = await contentService.lugares.listarPagina(
      {
        categoria: slug!,
        subcategoria: subcategoriaParam,
        zona: zonaParam,
        q: qParam,
      },
      paginaActual,
    );
  } else {
    listado = await contentService.lugares.listarPagina(
      {
        subcategoria: slug!,
        zona: zonaParam,
        q: qParam,
      },
      paginaActual,
    );
  }
}

// Fecha visible de cada evento en las tarjetas del listado.
const fechasEventos = esEventos
  ? listado.items.reduce<Record<string, string>>((acc, lugar) => {
      const fecha = fechaEvento(lugar, lang);
      if (fecha) acc[lugar.id] = fecha;
      return acc;
    }, {})
  : undefined;

const title = loc(categoria.data.title, lang) ?? slug!;
const description = loc(categoria.data.description, lang) ?? '';

const categoriaPadre = categoria.data.parent
  ? categoriasTodas.find((c) => c.collection === categoria.data.parent)
  : undefined;

const breadcrumbs = [
  { name: t(lang, 'nav.home'), url: localizePath('/', lang) },
  { name: t(lang, 'nav.categories'), url: localizePath('/categories/', lang) },
  ...(categoriaPadre
    ? [
        {
          name: loc(categoriaPadre.data.title, lang) ?? categoria.data.parent ?? slug!,
          url: localizePath(`/categories/${categoria.data.parent}/`, lang),
        },
      ]
    : []),
  { name: title },
];

const countLabel = esEventos
  ? `${listado.total} ${listado.total === 1 ? t(lang, 'count.event') : t(lang, 'count.events')}`
  : `${listado.total} ${listado.total === 1 ? t(lang, 'count.place') : t(lang, 'count.places')}`;

const emptyTitle =
  esEventos && mesCalendario
    ? t(lang, 'events.emptyMonthTitle')
    : t(lang, 'categories.emptyTitle');
const emptyBody =
  esEventos && mesCalendario
    ? t(lang, 'events.emptyMonthBody')
    : t(lang, 'categories.emptyBody');
---

<Layout
  lang={lang}
  title={`${title} ${t(lang, 'categories.inTumbes')}`}
  description={description}
  jsonLd={breadcrumbJsonLd(breadcrumbs)}
>
  <nav class="container-page breadcrumbs" aria-label={t(lang, 'nav.home')}>
    <ol class="breadcrumbs__list">
      {
        breadcrumbs.map((item, i) => (
          <>
            {i > 0 && <li class="breadcrumbs__sep" aria-hidden="true">/</li>}
            {
              item.url ? (
                <li>
                  <a class="breadcrumbs__link" href={item.url}>
                    {item.name}
                  </a>
                </li>
              ) : (
                <li aria-current="page">{item.name}</li>
              )
            }
          </>
        ))
      }
    </ol>
  </nav>

  <PageHeader
    title={`${title} ${t(lang, 'categories.inTumbes')}`}
    lead={description}
    icon={icono}
    image={categoria.data.image}
  />

  <AdBanner lang={lang} id={`category-${slug}-ad`} variant="minimal" />

  <!-- Subcategorías (nivel 2 del backend) de una categoría raíz. -->
  {
    subcategorias.length > 0 && (
      <section class="section">
        <div class="container-page">
          <div class="category-grid">
            {
              subcategorias.map((sub) => (
                <CategoryCard
                  categoria={sub}
                  count={conteos.porSubcategoria.get(sub.collection) ?? 0}
                  lang={lang}
                  section="subcategorias"
                />
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- "zones": las zonas geográficas se muestran como agrupación de lugares
       (atributo del contenido), no como una colección propia. -->
  {
    esSeccionZonas ? (
      <section class="section">
        <div class="container-page">
          <div class="dest-track-container">
            <div class="zone-grid">
              {
                zonas.map((z) => (
                  <ZoneCard
                    zona={z}
                    count={conteos.porZona.get(z.id) ?? 0}
                    lang={lang}
                  />
                ))
              }
            </div>
          </div>
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="container-page">
          {
            esEventos ? (
              <EventCalendarFilter mes={mesCalendario} lang={lang} />
            ) : (
              <CategoryFilterBar
                action={localizePath(`/categories/${slug}/`, lang)}
                lang={lang}
                subcategorias={esRaiz ? subcategorias : undefined}
                zonas={zonas}
                placeholder={!esRaiz ? `Buscar en ${title}…` : undefined}
                params={{
                  q: qParam,
                  subcategoria: subcategoriaParam,
                  zona: zonaParam,
                }}
              />
            )
          }
          <PlaceList
            lugares={listado.items}
            categorias={categoriasTodas}
            page={listado.page}
            totalPaginas={listado.totalPaginas}
            lang={lang}
            countLabel={countLabel}
            emptyTitle={emptyTitle}
            emptyBody={emptyBody}
            fechas={fechasEventos}
          />
        </div>
      </section>
    )
  }
</Layout>
