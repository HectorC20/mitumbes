---
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import CategoryCard from '@/components/category/CategoryCard.astro';
import AdBanner from '@/shared/components/ads/AdBanner.astro';
import { contentService } from '@/services/content.service';
import { type Locale, isLocale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const [categorias, conteos] = await Promise.all([
  contentService.categorias.listarRaices(),
  contentService.conteos.obtener(),
]);
---

<Layout lang={lang} title={t(lang, 'seo.categoriesTitle')} description={t(lang, 'seo.categoriesDescription')}>
  <PageHeader
    eyebrow={t(lang, 'categories.eyebrow')}
    title={t(lang, 'nav.categories')}
    lead={t(lang, 'categories.lead')}
  />

  <AdBanner lang={lang} id="categories-index-ad" variant="minimal" />

  <section class="section">
    <div class="container-page">
      <div class="category-grid">
        {
          categorias.map((c) => (
            <CategoryCard
              categoria={c}
              count={conteos.porCategoria.get(c.collection) ?? 0}
              lang={lang}
              section="categorias"
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
