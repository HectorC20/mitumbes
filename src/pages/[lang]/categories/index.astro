---
import Layout from '@/components/layout/Layout.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import CategoryCard from '@/components/category/CategoryCard.astro';
import AdBanner from '@/shared/components/ads/AdBanner.astro';
import { contentService } from '@/services/content.service';
import { type Locale, isLocale } from '@/shared/constants/locales';
import { t } from '@/shared/constants/ui';

const lang = Astro.params.lang as Locale;

if (!isLocale(lang)) {
  return Astro.redirect('/404/', 301);
}

const [categorias, conteos] = await Promise.all([
  contentService.categorias.listarRaices(),
  contentService.conteos.obtener(),
]);
---

<Layout lang={lang} title={t(lang, 'seo.categoriesTitle')} description={t(lang, 'seo.categoriesDescription')}>
  <PageHeader
    eyebrow={t(lang, 'categories.eyebrow')}
    title={t(lang, 'nav.categories')}
    lead={t(lang, 'categories.lead')}
  />

  <AdBanner lang={lang} id="categories-index-ad" variant="minimal" />

  <section class="section">
    <div class="container-page">
      <div class="mb-8 max-w-md">
        <label class="sr-only" for="category-search-input">{t(lang, 'categories.searchCategories')}</label>
        <input
          id="category-search-input"
          class="search-form__input w-full"
          type="search"
          placeholder={t(lang, 'categories.searchCategories')}
          autocomplete="off"
        />
      </div>

      <div id="categories-grid" class="category-grid">
        {
          categorias.map((c) => (
            <CategoryCard
              categoria={c}
              count={conteos.porCategoria.get(c.collection) ?? 0}
              lang={lang}
              section="categorias"
            />
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('category-search-input') as HTMLInputElement | null;
    const cards = document.querySelectorAll<HTMLElement>('#categories-grid .category-card');

    if (searchInput && cards.length > 0) {
      searchInput.addEventListener('input', () => {
        const query = searchInput.value.trim().toLowerCase();
        cards.forEach((card) => {
          const text = card.textContent?.toLowerCase() ?? '';
          if (!query || text.includes(query)) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }
  </script>
</Layout>
